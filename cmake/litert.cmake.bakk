# LiteRT Core Libraries
define_litert_target(litert_core        "liblitert_core.a"        "core")
define_litert_target(litert_c_api       "liblitert_c_api.a"       "c")
define_litert_target(litert_cc_api      "liblitert_cc_api.a"      "cc")
define_litert_target(litert_runtime     "liblitert_runtime.a"     "runtime")
# Note: litert_cc_internal is missing from your file list, remove if not needed.

# TFLite/TensorFlow Libraries
define_litert_target(tensorflow-lite    "libtensorflow-lite.a"    "tflite_build")
define_litert_target(xnnpack-delegate   "libxnnpack-delegate.a"   "tflite_build")
define_litert_target(xnnpack-core       "libXNNPACK.a"            "tflite_build/_deps/xnnpack-build")
define_litert_target(flatbuffers        "libflatbuffers.a"        "_deps/flatbuffers-build") # NOTE: This is the external dependency FB, not the TFLite FB.
add_library(litert_libs INTERFACE)

if(UNIX AND NOT APPLE)
    # LINUX: Use start/end group to handle circular dependencies between LiteRT libs
    target_link_libraries(litert_libs INTERFACE
        -Wl,--start-group
        litert_core
        litert_c_api
        litert_cc_api
        litert_cc_internal
        litert_runtime
        tensorflow-lite
        flatbuffer
        -Wl,--end-group
    )
else()
    # NON-LINUX: Standard linking (hope for the best regarding circular deps)
    target_link_libraries(litert_libs INTERFACE
        litert_core
        litert_c_api
        litert_cc_api
        litert_cc_internal
        litert_runtime
        tensorflow-lite
        flatbuffers
    )
endif()

target_include_directories(litert_libs INTERFACE ${LITERT_INCLUDE_DIR})
add_dependencies(litert_libs litert_external)


